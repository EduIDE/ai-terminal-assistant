{
  "name": "@fangoling/ai-terminal-assistant",
  "version": "0.1.0",
  "description": "EduIDE Terminal Assistant Extension",
  "dependencies": {
    "@theia/ai-core": "1.70.0",
    "@theia/core": "1.70.0",
    "@theia/terminal": "1.70.0",
    "@theia/debug": "1.70.0",
    "@theia/monaco": "1.70.0",
    "@theia/task": "1.70.0",
    "@theia/file-search": "1.70.0",
    "@theia/filesystem": "1.70.0",
    "@theia/workspace": "1.70.0",
    "@theia/monaco-editor-core": "1.108.201",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/ai-terminal-assistant-frontend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduIDE/ai-terminal-assistant"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "rimraf": "latest",
    "typescript": "~5.4.5"
  }
}
